# ============================================
# AI CCTV Detection — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Cara pakai: cp .env.example .env  lalu isi nilainya.

# ------------------------------------------------------------------
# Telegram Bot Configuration (REQUIRED untuk notifikasi & link mobile)
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ------------------------------------------------------------------
# Mobile Dashboard Security PIN
# Kosongkan / hapus baris ini untuk nonaktifkan PIN (akses bebas LAN)
# Isi angka 4-8 digit untuk aktifkan PIN gate di akses publik
# ------------------------------------------------------------------
# DASHBOARD_PIN=

# ------------------------------------------------------------------
# Cloudflare Tunnel
# Kosongkan = pakai Quick Tunnel (URL random, gratis, tanpa akun)
# Isi token = pakai Named Tunnel (URL tetap, perlu akun Cloudflare)
# ------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------
# Public URL (diisi otomatis saat tunnel terhubung, bisa override manual)
# ------------------------------------------------------------------
PUBLIC_URL=https://heart-missouri-coffee-somewhere.trycloudflare.com

# ------------------------------------------------------------------
# Device Configuration (optional, overrides config.yaml)
# ------------------------------------------------------------------
# DEVICE_MODE=auto
# MODEL_NAME=yolov8n.pt
